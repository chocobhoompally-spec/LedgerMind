# LedgerMind — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── AI / Memory ────────────────────────────────────────────
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here

GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_RETRIES=3

# ── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite:///ledgermind.db

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRY_HOURS=24

# ── GST Rule Thresholds ────────────────────────────────────
# Maximum rounding difference (₹) before it becomes a real mismatch
ROUNDING_LIMIT=10

# Minimum past approvals needed before auto-approving an issue type
MIN_EVIDENCE=2

# Minimum AI confidence (0.0–1.0) to auto-approve
MIN_CONFIDENCE=0.8

# Invoices above this amount (₹) are always sent to human review
MAX_AUTO_APPROVE_AMOUNT=500000

# Amount differences above this (₹) are always sent to human review
MAX_AUTO_APPROVE_DIFF=100
